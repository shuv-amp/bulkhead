# systemd unit for a Bulkhead guardian (docs/07 §6). One instance per guarded
# protocol: /etc/bulkhead/<name>.json holds its config, started as
#   systemctl enable --now bulkhead-guardian@<name>
#
# The guardian exits on anything it cannot recover from (logged, and alerted
# when `alert` is set); systemd starts a fresh one. In the config, point
# "stateFile" at /var/lib/bulkhead/<name>.state.json so an incident hold
# survives restarts, and keep the guardian key readable by this user only.
[Unit]
Description=Bulkhead guardian (%i)
# Heartbeat standing, the incident hold's renewal and approval expiry read the
# wall clock: start only once it is synchronized (docs/09, finding 83).
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# Never give up restarting: a guardian that stays down cannot freeze.
StartLimitIntervalSec=0

[Service]
Type=simple
User=bulkhead
Group=bulkhead
ExecStart=/usr/bin/env node /opt/bulkhead/cloud/guardian/main.mjs /etc/bulkhead/%i.json
Restart=always
RestartSec=5
StateDirectory=bulkhead
StateDirectoryMode=0700
# One JSON line per decision on stdout: journalctl -u bulkhead-guardian@<name>
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK: glibc's getaddrinfo lists interfaces with it (AI_ADDRCONFIG);
# without it an RPC or webhook named by host would never resolve.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
UMask=0077
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
# Node's syscalls; anything else fails with EPERM (libuv falls back) rather
# than killing the guardian. No MemoryDenyWriteExecute: V8 compiles code.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
